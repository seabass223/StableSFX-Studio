{
  "name": "stablesfx-studio",
  "productName": "StableSFX Studio",
  "version": "0.1.0",
  "description": "Generate, modify and organise game sound effects with Stable Audio 3",
  "author": "Kyle Sebestyen",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:dir": "electron-builder --win --x64 --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src --max-warnings 0",
    "gen:api": "openapi-typescript engine/openapi.json -o src/shared/engine-api.d.ts",
    "copy-uv": "node scripts/copy-uv.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "build": {
    "appId": "com.kylesebestyen.stablesfx",
    "productName": "StableSFX Studio",
    "directories": {
      "output": "dist/.work/electron-builder",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!dist/**",
      "!engine/**",
      "!src/**",
      "!scripts/**"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "pyproject.toml",
          "uv.lock",
          ".python-version",
          "stablesfx_engine/**/*.py"
        ]
      },
      {
        "from": "resources/uv.exe",
        "to": "uv.exe"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    },
    "asar": true
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "wavesurfer.js": "^7.12.12",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
